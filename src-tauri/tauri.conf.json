{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helm",
  "version": "0.1.1",
  "identifier": "com.mdayan.helm",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main", "title": "Helm", "width": 1500, "height": 920,
      "minWidth": 700, "minHeight": 400,
      "titleBarStyle": "Overlay", "hiddenTitle": true,
      "dragDropEnabled": false, "transparent": true
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"] }
}
